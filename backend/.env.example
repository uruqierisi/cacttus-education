# ---------------------------------------------------------------------------
# Cacttus Education — backend environment
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database (Neon Postgres) ----------------------------------------------
# Use the POOLED connection string for the app. Neon requires sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/cacttus?sslmode=require"
# Direct (non-pooled) URL — REQUIRED for `prisma migrate` / `prisma db push`.
# Same string as above but WITHOUT `-pooler` in the host. Neon's pooler cannot run
# DDL, so Prisma routes migrations here via `directUrl` in schema.prisma.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/cacttus?sslmode=require"

# --- JWT -------------------------------------------------------------------
# Generate each independently, 32+ chars:  openssl rand -base64 48
# They MUST be different values — a leaked access secret must not mint refresh tokens.
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
# Access token lifetime (short — it is held in dashboard memory only).
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime (long — httpOnly cookie).
REFRESH_TOKEN_TTL=7d

# --- Cookies ---------------------------------------------------------------
# Leave COOKIE_DOMAIN empty in development (host-only cookie on localhost).
# In production set the shared parent domain, e.g. .cacttus.education
COOKIE_DOMAIN=
# Must be true in production (HTTPS only).
COOKIE_SECURE=false
# strict | lax | none — keep `strict` unless the dashboard is on a different site.
COOKIE_SAMESITE=strict

# --- CORS ------------------------------------------------------------------
# The admin dashboard (credentialed: cookies allowed).
DASHBOARD_ORIGIN=http://localhost:5173
# The public marketing site (cacttus-edu-front). PUBLIC endpoints only — this origin
# is deliberately absent from `credentialedOrigins`, so the API never answers it with
# `Access-Control-Allow-Credentials`. See config/cors.ts for why that matters.
# Its dev server is pinned to 5174 (strictPort) so it can never collide with 5173.
MARKETING_ORIGIN=http://localhost:5174
# Optional comma-separated extras (preview deploys, staging). May be empty.
EXTRA_ALLOWED_ORIGINS=

# --- Security tuning -------------------------------------------------------
BCRYPT_ROUNDS=12
# Login throttle: attempts per window, per IP.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Public form submission throttle, per IP.
PUBLIC_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
# General API throttle, per IP.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=900000
# Number of reverse proxies in front of the API (Railway/Vercel = 1). 0 = direct.
TRUST_PROXY_HOPS=1

# --- Seed (development / first boot only) ----------------------------------
# Plaintext passwords consumed ONLY by `npm run db:seed`, then bcrypt-hashed.
# Defaults below are intentionally obvious placeholders. Override them locally and
# ALWAYS override them before seeding any shared or production database.
SEED_ADMIN_EMAIL=admin@cacttus.education
SEED_ADMIN_NAME="Cacttus Admin"
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!
SEED_EDITOR_EMAIL=editor@cacttus.education
SEED_EDITOR_NAME="Cacttus Editor"
SEED_EDITOR_PASSWORD=ChangeMe_Editor_123!

# --- Uploads (blog cover images) ------------------------------------------
# Where uploaded images are written. Relative paths resolve from the backend working
# directory, so the default lands in backend/uploads.
# DEPLOYMENT: on the server this MUST point OUTSIDE the repo (e.g. /var/lib/cacttus/uploads)
# and, if the API runs in Docker, be a mounted volume — otherwise images are destroyed by
# the next deploy or container restart. Back this directory up: it is not in the database.
UPLOAD_DIR=./uploads
# Absolute public base URL of THIS API. Used to build cover-image URLs that the marketing
# site (a different origin) can render. Changing the API hostname invalidates stored URLs.
PUBLIC_API_URL=http://localhost:4000
