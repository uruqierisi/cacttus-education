// Cacttus Education — Prisma schema
//
// Design notes
// ------------
// * Forms are GENERIC: one `Form` row per public form, with its field definitions
//   stored as JSON. Adding a new form (or a new question) is a data change, never a
//   migration.
// * Forms are SOFT deleted (`deletedAt`). Nothing in the admin API ever issues a
//   hard `DELETE` on a form, so historical submissions always keep a valid parent.
// * `Submission` promotes name / email / phone to real columns because every form
//   collects them and every admin workflow (filter, export, contact) needs them
//   indexable; everything else lives in the `data` JSONB blob.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) endpoint — used by the running app.
  url       = env("DATABASE_URL")
  // Direct, non-pooled endpoint — Neon's pooler cannot run DDL, so migrations
  // must bypass it. Prisma uses this automatically for `migrate` / `db push`.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum FormType {
  ZHVAM
  CYBER
  TRAINING
  SCHOOL
}

enum SubmissionStatus {
  NEW
  CONTACTED
  ARCHIVED
}

// Catalogue taxonomy for trainings. Stored as an enum rather than free text because the
// public site renders these as FILTER CHIPS: a typo in a city is a cosmetic bug, but a
// typo in a category silently creates a chip nobody can click twice. The Albanian display
// labels live in the frontends — this is the stable machine value.
enum TrainingFormat {
  KLASE
  HIBRID
  ONLINE
}

/// Where a training is in its lifecycle. English identifiers like every other enum in
/// this schema (TrainingCategory, TrainingFormat); the Albanian labels "Aktive" and
/// "Përfunduar" are a presentation concern and live in the two frontends.
///
/// Deliberately NOT folded into the existing `isActive` boolean. That flag answers
/// "should this be published at all" — an unpublished training vanishes from the public
/// catalogue entirely. This answers "has it finished", and a finished training is still
/// worth showing, just badged. Two different questions, two different columns.
enum TrainingStatus {
  ACTIVE
  COMPLETED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_DELETED
  FORM_CREATED
  FORM_UPDATED
  FORM_DELETED
  FORM_RESTORED
  SUBMISSION_STATUS_CHANGED
  // Bulk CSV movements of the lead inbox. Both are STAFF actions on a set of rows
  // rather than on one row, so their `entityId` is null and the row count lives in
  // `metadata` — never the exported/imported PII itself.
  SUBMISSIONS_EXPORTED
  SUBMISSIONS_IMPORTED
  POST_CREATED
  POST_UPDATED
  POST_DELETED
  // Training catalog (marketing site) — same soft-delete / staff-only shape as Form.
  TRAINING_CREATED
  TRAINING_UPDATED
  TRAINING_DELETED
  // The catalogue taxonomy, once an enum and now an editable table. DELETED is a HARD
  // delete here, unlike every other *_DELETED in this enum — a category has no history
  // to preserve and is refused outright while any training still references it.
  TRAINING_CATEGORY_CREATED
  TRAINING_CATEGORY_UPDATED
  TRAINING_CATEGORY_DELETED
  // The blog taxonomy. DELETED is a HARD delete, refused while any post references it.
  POST_CATEGORY_CREATED
  POST_CATEGORY_UPDATED
  POST_CATEGORY_DELETED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(EDITOR)

  // Deactivation instead of deletion. A user who has authored posts cannot be hard
  // deleted (Post.authorId is onDelete: Restrict), and losing the byline on published
  // articles would be worse than keeping a dormant row. `requireAuth` rejects an
  // inactive account on the very next request.
  isActive Boolean @default(true)

  // Stateless session revocation. Any token whose `iat` predates this instant is
  // refused, which is what makes an admin password reset actually evict a compromised
  // session instead of leaving its refresh cookie alive until TTL. Bumped on both
  // self-service change-password and admin reset.
  passwordChangedAt DateTime @default(now())

  createdAt DateTime @default(now())

  posts Post[]

  // Back-relation only. Deleting a user nulls `AuditLog.actorId` rather than blocking
  // the delete, so this relation never keeps a user row alive — see AuditLog.
  auditLogs AuditLog[]

  // The user list defaults to active accounts only.
  @@index([isActive])
  @@map("users")
}

model Form {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  type      FormType
  /// FormFieldDefinition[] — see src/services/form-fields.service.ts for the contract.
  fields    Json      @default("[]")
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  submissions Submission[]

  // Every admin list query filters `deletedAt IS NULL`; every public lookup filters
  // `deletedAt IS NULL AND isActive = true`. Indexing the nullable column keeps the
  // default "live forms" scan cheap as the soft-deleted tail grows.
  @@index([deletedAt])
  // The dashboard groups forms by product line (ZHVAM / CYBER / TRAINING / SCHOOL).
  @@index([type])
  @@map("forms")
}

model Submission {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Restrict)

  name   String
  email  String
  phone  String
  /// Answers keyed by FormFieldDefinition.name.
  data   Json             @default("{}")
  status SubmissionStatus @default(NEW)

  // PROVENANCE, not the application path — every application still goes through a Form
  // (formId above stays required and unchanged). This records that the applicant landed
  // via a training's detail page rather than a bare form link shared elsewhere (e.g.
  // social media). Null means "came from the form directly". `onDelete: Restrict`
  // mirrors `formId`'s reasoning: a Training with submissions is soft-deleted
  // (deletedAt) and never hard-deleted, so this constraint can never actually fire — it
  // exists only to turn an accidental hard delete into a loud error instead of silently
  // orphaning submissions.
  trainingId String?
  training   Training? @relation(fields: [trainingId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  // Foreign-key lookups: "show me every submission for this form".
  @@index([formId])
  // The inbox default view is `status = NEW`, ordered newest first.
  @@index([status])
  // Global "latest submissions" widget + date-range CSV export.
  @@index([createdAt])
  // Covering index for the main inbox query shape:
  // WHERE formId = ? AND status = ? ORDER BY createdAt DESC.
  @@index([formId, status, createdAt])
  // "Every application that came from this training's detail page".
  @@index([trainingId])
  @@map("submissions")
}

/// The catalogue taxonomy, as DATA rather than as an enum.
///
/// It began as `enum TrainingCategory`, which meant every new category was a schema
/// change, a migration and a deploy of three apps — for what is editorial vocabulary the
/// marketing team owns. The six original values migrated across verbatim, labels
/// included, so nothing a visitor reads changed on the day this landed.
///
/// `name` IS the label. There is no machine-value/display-label pair any more: the old
/// `PROGRAMIM` -> "Programim" map lived in two frontends and had to be edited in both,
/// which is exactly the coupling this removes. `slug` is the stable handle for URLs and
/// query parameters, so renaming a category for display does not break a shared link.
model TrainingCategory {
  id        String   @id @default(cuid())
  /// Shown to admins and visitors verbatim. Unique so two categories cannot read alike.
  name      String   @unique
  /// URL-safe handle: the public catalogue filters on `?category=<slug>`.
  slug      String   @unique
  /// Display order in the dashboard select and in the public filter chips. Ties fall
  /// back to `name`, so the ordering is total even when several share a number.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  trainings Training[]

  @@index([sortOrder])
  @@map("training_categories")
}

model Training {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  categoryId String
  /// `Restrict`, not `Cascade` or `SetNull`: deleting a category that trainings still
  /// reference must FAIL. The service layer counts references inside the delete
  /// transaction and returns a readable Albanian error before it ever gets here — this
  /// constraint is the backstop for anything that bypasses the service (a script, a
  /// manual psql session), not the primary guard.
  category   TrainingCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // --- Catalog card (marketing site listing) ---
  startDate       DateTime?
  format          TrainingFormat
  hours           Int?
  // The instructor, denormalised onto the training rather than modelled as its own
  // entity. Still free text: the marketing site has never needed to link an instructor
  // across trainings, filter by them, or show a standalone profile page. The detail
  // page's bio block reads these three columns and nothing else — if a person ever needs
  // one profile shared across several trainings, THAT is when a Trainer model earns its
  // keep, and these columns become its backfill source.
  instructor      String?
  // Public URL of an uploaded portrait, not the file itself — same contract as
  // `syllabusPdf` and `Post.coverImage`, so an upload and a pasted link are one shape.
  instructorPhoto String?
  // Capped at FIELD_LIMITS.INSTRUCTOR_BIO_MAX (5 000) at the validation boundary.
  // `@db.Text` precisely so that ceiling can be re-tuned without a migration — which is
  // what happened when it moved from 600 to 5 000; the real ceiling is the Zod one.
  instructorBio   String?        @db.Text
  city            String?

  // Whole euros, not cents. The catalogue has never priced anything in fractions and an
  // Int keeps the dashboard input, the API and the rendered "250 €" the same number all
  // the way through — no scaling step to get wrong. Nullable because a training whose
  // price is not settled yet still belongs in the catalogue; the detail page renders "—"
  // for it exactly like the other optional card fields.
  price Int?

  // --- Detail page, all optional: the admin fills only what a given training needs ---
  description String? @db.Text // "Çfarë do të mësosh" — free text.
  /// string[] — "Pikat e Forta" bullet list. Each entry is one bullet's plain text; no
  /// nested structure, matching the simplicity of Form.fields' documented contract.
  strengths   Json?

  /// "Rolet e punës që mund t'i fitosh" — the job titles this training prepares for, one
  /// short label per entry ("Front-End Developer").
  ///
  /// A native scalar list, NOT a Json column like `strengths` above. Two reasons: these
  /// are short tokens with no chance of growing structure, and a text[] is queryable —
  /// "which trainings lead to a QA role" is a plausible future filter that Json would
  /// make awkward. Postgres scalar lists cannot be null, only empty, which is exactly
  /// the optionality wanted here: a training with no roles set stores `[]` and the
  /// detail page renders no section at all.
  jobRoles String[]

  syllabusPdf String? // Public URL of an uploaded PDF, not the file itself.

  // Slug (not a foreign key) of the Form the detail page's "Apliko" button submits to.
  // This is a DELIBERATE denormalisation for read speed on the public detail page: the
  // URL already carries the training slug, so resolving the form by slug in the same
  // request avoids a second indexed lookup keyed on anything else. The cost is that
  // renaming a Form's slug later would orphan this reference — Form.slug has no
  // reverse-reference back to trainings that point at it. The SERVICE layer (not this
  // schema) owns the contract that keeps that safe: (a) on write, validate that
  // formSlug names a Form that exists, is active, and is not soft-deleted; (b) on read,
  // degrade gracefully — the public detail endpoint must still return the training with
  // the form/Apliko section simply absent, never a 500, if the slug no longer resolves.
  formSlug String

  /// Defaults to ACTIVE so creating a training needs no extra decision, and so the
  /// migration backfills every existing row as active without a data step.
  status TrainingStatus @default(ACTIVE)

  isActive  Boolean   @default(true)
  order     Int       @default(0)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]

  // The public catalog's category filter tabs.
  @@index([categoryId])
  // The public catalog's city filter.
  @@index([city])
  // The public catalog's status filter, same shape as the two above.
  @@index([status])
  // Every list query (admin default + public catalog) filters on this pair; the public
  // catalog additionally requires isActive = true, deletedAt IS NULL, same shape as Form.
  @@index([isActive, deletedAt])
  @@map("trainings")
}

/// The blog taxonomy. Same shape as `TrainingCategory`, and deliberately a SEPARATE
/// table rather than a shared one: a training category ("Siguri Kibernetike") and a post
/// category ("Karriera") answer different questions, and one shared list would put every
/// training category into the /lajme chips the day someone added one.
model PostCategory {
  id        String   @id @default(cuid())
  /// Shown to admins and visitors verbatim. Unique so two categories cannot read alike.
  name      String   @unique
  /// URL-safe handle: the public feed filters on `?category=<slug>`.
  slug      String   @unique
  /// Display order in the dashboard select and in the public filter chips. Ties fall
  /// back to `name`, so the ordering is total even when several share a number.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  posts Post[]

  @@index([sortOrder])
  @@map("post_categories")
}

model Post {
  id         String  @id @default(cuid())
  slug       String  @unique
  title      String
  coverImage String?
  content    String  @db.Text
  published  Boolean @default(false)

  /// NULLABLE, unlike `Training.categoryId`. Every post that exists today predates this
  /// column and there is no honest value to backfill them with — guessing a category
  /// from a title would mislabel the archive. An uncategorised post stays valid, is
  /// served exactly as before, and appears under "Të gjitha" on the public feed.
  categoryId String?
  /// `Restrict`, not `SetNull`: deleting a category that posts still reference must FAIL
  /// rather than silently strip the label off them. The service counts references inside
  /// the delete transaction and returns a readable Albanian error first — this is the
  /// backstop for anything that bypasses the service.
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The public marketing feed only ever reads `published = true`.
  @@index([published])
  // Same feed, but ordered — lets Postgres satisfy filter + sort from one index.
  @@index([published, createdAt])
  // "Posts by this author" in the dashboard.
  @@index([authorId])
  // The public feed's category filter.
  @@index([categoryId])
  @@map("posts")
}

// APPEND-ONLY by design. Nothing anywhere in the codebase ever issues an `update` or a
// `delete` against this table — the only write is `create`. That is also why
// `actorEmail` / `actorRole` are denormalised snapshot columns rather than a join:
// reading the trail must never depend on the actor row still existing, and it must show
// who the actor WAS at the time of the action, not who they are now.
model AuditLog {
  id String @id @default(cuid())

  // Nullable on purpose. `onDelete: SetNull` requires an optional FK field in Prisma,
  // and SetNull is exactly the point here: this deliberately differs from
  // `Post.authorId` (onDelete: Restrict), which blocks the delete to protect a published
  // byline. An audit trail must instead OUTLIVE the user it describes — a deleted
  // account may not erase the record of what it did, so the log row survives with a
  // null `actorId` and the `actorEmail` / `actorRole` snapshot carries the identity.
  actorId    String?
  actorEmail String
  actorRole  Role

  action     AuditAction
  /// "Form" | "Submission" | "User" | "Post" | "Auth" | "Training" | "TrainingCategory"
  /// | "PostCategory"
  entityType String
  // Null for auth events, which act on a session rather than on a row.
  entityId   String?
  /// Small structured diff / context. NEVER passwords, tokens, or full PII.
  metadata   Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // The default trail view is global, newest first.
  @@index([createdAt])
  // "Everything this user did", newest first.
  @@index([actorId, createdAt])
  // "History of this specific row" — the per-entity timeline.
  @@index([entityType, entityId])
  // Filtered views such as "all failed logins", newest first.
  @@index([action, createdAt])
  @@map("audit_logs")
}
