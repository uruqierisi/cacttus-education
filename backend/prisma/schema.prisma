// Cacttus Education — Prisma schema
//
// Design notes
// ------------
// * Forms are GENERIC: one `Form` row per public form, with its field definitions
//   stored as JSON. Adding a new form (or a new question) is a data change, never a
//   migration.
// * Forms are SOFT deleted (`deletedAt`). Nothing in the admin API ever issues a
//   hard `DELETE` on a form, so historical submissions always keep a valid parent.
// * `Submission` promotes name / email / phone to real columns because every form
//   collects them and every admin workflow (filter, export, contact) needs them
//   indexable; everything else lives in the `data` JSONB blob.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) endpoint — used by the running app.
  url       = env("DATABASE_URL")
  // Direct, non-pooled endpoint — Neon's pooler cannot run DDL, so migrations
  // must bypass it. Prisma uses this automatically for `migrate` / `db push`.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum FormType {
  ZHVAM
  CYBER
  TRAINING
  SCHOOL
}

enum SubmissionStatus {
  NEW
  CONTACTED
  ARCHIVED
}

// Catalogue taxonomy for trainings. Stored as an enum rather than free text because the
// public site renders these as FILTER CHIPS: a typo in a city is a cosmetic bug, but a
// typo in a category silently creates a chip nobody can click twice. The Albanian display
// labels live in the frontends — this is the stable machine value.
enum TrainingCategory {
  PROGRAMIM
  ADMINISTRIM
  SIGURI_KIBERNETIKE
  MARKETING_DIZAJN
  MENAXHIM_PROJEKTEVE
  AFTESI_TE_BUTA
}

enum TrainingFormat {
  KLASE
  HIBRID
  ONLINE
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_DELETED
  FORM_CREATED
  FORM_UPDATED
  FORM_DELETED
  FORM_RESTORED
  SUBMISSION_STATUS_CHANGED
  // Bulk CSV movements of the lead inbox. Both are STAFF actions on a set of rows
  // rather than on one row, so their `entityId` is null and the row count lives in
  // `metadata` — never the exported/imported PII itself.
  SUBMISSIONS_EXPORTED
  SUBMISSIONS_IMPORTED
  POST_CREATED
  POST_UPDATED
  POST_DELETED
  // Training catalog (marketing site) — same soft-delete / staff-only shape as Form.
  TRAINING_CREATED
  TRAINING_UPDATED
  TRAINING_DELETED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(EDITOR)

  // Deactivation instead of deletion. A user who has authored posts cannot be hard
  // deleted (Post.authorId is onDelete: Restrict), and losing the byline on published
  // articles would be worse than keeping a dormant row. `requireAuth` rejects an
  // inactive account on the very next request.
  isActive Boolean @default(true)

  // Stateless session revocation. Any token whose `iat` predates this instant is
  // refused, which is what makes an admin password reset actually evict a compromised
  // session instead of leaving its refresh cookie alive until TTL. Bumped on both
  // self-service change-password and admin reset.
  passwordChangedAt DateTime @default(now())

  createdAt DateTime @default(now())

  posts Post[]

  // Back-relation only. Deleting a user nulls `AuditLog.actorId` rather than blocking
  // the delete, so this relation never keeps a user row alive — see AuditLog.
  auditLogs AuditLog[]

  // The user list defaults to active accounts only.
  @@index([isActive])
  @@map("users")
}

model Form {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  type      FormType
  /// FormFieldDefinition[] — see src/services/form-fields.service.ts for the contract.
  fields    Json      @default("[]")
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  submissions Submission[]

  // Every admin list query filters `deletedAt IS NULL`; every public lookup filters
  // `deletedAt IS NULL AND isActive = true`. Indexing the nullable column keeps the
  // default "live forms" scan cheap as the soft-deleted tail grows.
  @@index([deletedAt])
  // The dashboard groups forms by product line (ZHVAM / CYBER / TRAINING / SCHOOL).
  @@index([type])
  @@map("forms")
}

model Submission {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Restrict)

  name   String
  email  String
  phone  String
  /// Answers keyed by FormFieldDefinition.name.
  data   Json             @default("{}")
  status SubmissionStatus @default(NEW)

  // PROVENANCE, not the application path — every application still goes through a Form
  // (formId above stays required and unchanged). This records that the applicant landed
  // via a training's detail page rather than a bare form link shared elsewhere (e.g.
  // social media). Null means "came from the form directly". `onDelete: Restrict`
  // mirrors `formId`'s reasoning: a Training with submissions is soft-deleted
  // (deletedAt) and never hard-deleted, so this constraint can never actually fire — it
  // exists only to turn an accidental hard delete into a loud error instead of silently
  // orphaning submissions.
  trainingId String?
  training   Training? @relation(fields: [trainingId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  // Foreign-key lookups: "show me every submission for this form".
  @@index([formId])
  // The inbox default view is `status = NEW`, ordered newest first.
  @@index([status])
  // Global "latest submissions" widget + date-range CSV export.
  @@index([createdAt])
  // Covering index for the main inbox query shape:
  // WHERE formId = ? AND status = ? ORDER BY createdAt DESC.
  @@index([formId, status, createdAt])
  // "Every application that came from this training's detail page".
  @@index([trainingId])
  @@map("submissions")
}

model Training {
  id    String           @id @default(cuid())
  slug  String           @unique
  title String
  category TrainingCategory

  // --- Catalog card (marketing site listing) ---
  startDate  DateTime?
  format     TrainingFormat
  hours      Int?
  // The card's "Ligjëruesi" (instructor) text ONLY — there is no trainer-bio section or
  // Trainer entity anywhere in this schema. Free text because the marketing site has
  // never needed to link an instructor across trainings, filter by them, or show a
  // profile; adding that structure now would be speculative.
  instructor String?
  city       String?

  // --- Detail page, all optional: the admin fills only what a given training needs ---
  description String? @db.Text // "Çfarë do të mësosh" — free text.
  /// string[] — "Pikat e Forta" bullet list. Each entry is one bullet's plain text; no
  /// nested structure, matching the simplicity of Form.fields' documented contract.
  strengths   Json?
  syllabusPdf String? // Public URL of an uploaded PDF, not the file itself.

  // Slug (not a foreign key) of the Form the detail page's "Apliko" button submits to.
  // This is a DELIBERATE denormalisation for read speed on the public detail page: the
  // URL already carries the training slug, so resolving the form by slug in the same
  // request avoids a second indexed lookup keyed on anything else. The cost is that
  // renaming a Form's slug later would orphan this reference — Form.slug has no
  // reverse-reference back to trainings that point at it. The SERVICE layer (not this
  // schema) owns the contract that keeps that safe: (a) on write, validate that
  // formSlug names a Form that exists, is active, and is not soft-deleted; (b) on read,
  // degrade gracefully — the public detail endpoint must still return the training with
  // the form/Apliko section simply absent, never a 500, if the slug no longer resolves.
  formSlug String

  isActive Boolean   @default(true)
  order    Int       @default(0)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]

  // The public catalog's category filter tabs.
  @@index([category])
  // The public catalog's city filter.
  @@index([city])
  // Every list query (admin default + public catalog) filters on this pair; the public
  // catalog additionally requires isActive = true, deletedAt IS NULL, same shape as Form.
  @@index([isActive, deletedAt])
  @@map("trainings")
}

model Post {
  id         String  @id @default(cuid())
  slug       String  @unique
  title      String
  coverImage String?
  content    String  @db.Text
  published  Boolean @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The public marketing feed only ever reads `published = true`.
  @@index([published])
  // Same feed, but ordered — lets Postgres satisfy filter + sort from one index.
  @@index([published, createdAt])
  // "Posts by this author" in the dashboard.
  @@index([authorId])
  @@map("posts")
}

// APPEND-ONLY by design. Nothing anywhere in the codebase ever issues an `update` or a
// `delete` against this table — the only write is `create`. That is also why
// `actorEmail` / `actorRole` are denormalised snapshot columns rather than a join:
// reading the trail must never depend on the actor row still existing, and it must show
// who the actor WAS at the time of the action, not who they are now.
model AuditLog {
  id String @id @default(cuid())

  // Nullable on purpose. `onDelete: SetNull` requires an optional FK field in Prisma,
  // and SetNull is exactly the point here: this deliberately differs from
  // `Post.authorId` (onDelete: Restrict), which blocks the delete to protect a published
  // byline. An audit trail must instead OUTLIVE the user it describes — a deleted
  // account may not erase the record of what it did, so the log row survives with a
  // null `actorId` and the `actorEmail` / `actorRole` snapshot carries the identity.
  actorId    String?
  actorEmail String
  actorRole  Role

  action     AuditAction
  /// "Form" | "Submission" | "User" | "Post" | "Auth"
  entityType String
  // Null for auth events, which act on a session rather than on a row.
  entityId   String?
  /// Small structured diff / context. NEVER passwords, tokens, or full PII.
  metadata   Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // The default trail view is global, newest first.
  @@index([createdAt])
  // "Everything this user did", newest first.
  @@index([actorId, createdAt])
  // "History of this specific row" — the per-entity timeline.
  @@index([entityType, entityId])
  // Filtered views such as "all failed logins", newest first.
  @@index([action, createdAt])
  @@map("audit_logs")
}
