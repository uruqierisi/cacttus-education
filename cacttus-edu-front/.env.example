# ---------------------------------------------------------------------------
# Cacttus Education — marketing site environment
#
# Copy to `.env.local` (git-ignored). Only VITE_-prefixed variables reach the
# browser, and EVERYTHING here is public once built — never put a secret in this
# file or in `.env.local`.
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing slash).
#
# The marketing site talks ONLY to `/api/public/*` and sends NO cookies and NO
# credentials. It is not on the API's credentialed-origin list and must never be.
VITE_API_BASE_URL=http://localhost:4000
