# ---------------------------------------------------------------------------
# Cacttus Education — dashboard environment
# Copy to `.env.local`. Only VITE_-prefixed vars reach the browser, and everything
# here is PUBLIC once built — never put a secret in this file.
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:4000

# Shown in the sidebar footer to make "which environment am I in" obvious.
VITE_APP_ENV=development
