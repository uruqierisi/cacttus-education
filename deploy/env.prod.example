# ---------------------------------------------------------------------------
# copy to ~/apps/cacttus/.env.prod on the server, fill secrets, chmod 600
#
# Every REPLACE_ME below is a real secret and must be replaced. Generate the JWT
# secrets independently:  openssl rand -base64 48
#
# This file feeds BOTH the backend container (env_file) and Compose's own
# ${...} interpolation for the db service, so run compose with
# `--env-file .env.prod` (the `dc` alias in README.md already does).
# ---------------------------------------------------------------------------

# --- Postgres (consumed by the db service AND by DATABASE_URL below) -------
POSTGRES_USER=cacttus
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
POSTGRES_DB=cacttus

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000
# No HOST line on purpose: the schema requires a non-empty string when present,
# so `HOST=` fails validation and the API refuses to boot. Omitting it binds
# every interface, which is what the container needs.

# --- Database --------------------------------------------------------------
# `db` is the compose service name on the internal network. No sslmode: the
# connection never leaves the Docker bridge. The password must match
# POSTGRES_PASSWORD above.
DATABASE_URL="postgresql://cacttus:REPLACE_ME_POSTGRES_PASSWORD@db:5432/cacttus"
# Prisma runs migrations through this one. Same string — there is no pooler here.
DIRECT_DATABASE_URL="postgresql://cacttus:REPLACE_ME_POSTGRES_PASSWORD@db:5432/cacttus"

# --- JWT -------------------------------------------------------------------
# MUST be different values, 32+ chars each. The API refuses to boot if they match.
JWT_ACCESS_SECRET="REPLACE_ME_ACCESS_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="REPLACE_ME_DIFFERENT_REFRESH_SECRET_MIN_32_CHARS"
ACCESS_TOKEN_TTL=15m
# 12h, not the 7d default. Logout clears the browser's cookie but does not
# invalidate the token itself, so the TTL is what actually bounds a stolen
# refresh cookie (security audit H2). Shorten further if that becomes cheap.
REFRESH_TOKEN_TTL=12h

# --- Cookies ---------------------------------------------------------------
# Shared parent domain so the cookie set by api.cacttus.education is sent back
# from the dashboard origin.
COOKIE_DOMAIN=.cacttus.education
# Must be true in production — the API refuses to boot otherwise.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# --- CORS ------------------------------------------------------------------
# The only origin answered with Access-Control-Allow-Credentials.
DASHBOARD_ORIGIN=https://admin.cacttus.education
# Public endpoints only — deliberately NOT credentialed. See src/config/cors.ts.
MARKETING_ORIGIN=https://cacttus.education
EXTRA_ALLOWED_ORIGINS=
# Must stay EMPTY: the API refuses to boot with this set while NODE_ENV=production.
EXTRA_CREDENTIALED_ORIGINS=

# --- Security tuning -------------------------------------------------------
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=900000
# Exactly one reverse proxy (Caddy) in front of the API. Raising this without a
# second real proxy lets a client forge X-Forwarded-For and reset its own rate limit.
TRUST_PROXY_HOPS=1

# --- Seed (first boot only) ------------------------------------------------
# Consumed only by `npm run db:seed`. The seed script REFUSES to run with the
# repo's placeholder passwords while NODE_ENV is not "development", so these
# must be real values before the first seed — and should be changed again from
# inside the dashboard afterwards.
SEED_ADMIN_EMAIL=admin@cacttus.education
SEED_ADMIN_NAME="Cacttus Admin"
SEED_ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
SEED_EDITOR_EMAIL=editor@cacttus.education
SEED_EDITOR_NAME="Cacttus Editor"
SEED_EDITOR_PASSWORD=REPLACE_ME_EDITOR_PASSWORD

# --- Uploads ---------------------------------------------------------------
# Inside the container. Bind-mounted from ~/apps/cacttus/uploads on the host, so
# the files survive a rebuild. Back this directory up — it is not in the database.
UPLOAD_DIR=/data/uploads
# Absolute public base URL of this API. Stored cover-image URLs embed it, so
# changing it later invalidates every URL already in the database.
PUBLIC_API_URL=https://api.cacttus.education
